{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scentmarked",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://qnlqdkctfmfagsvbwiis.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_DhzPVepdeQt-1Xt00CBOsw_cl30TcYp",
    // Add NEXT_PUBLIC_SITE_URL here when the custom Scentmarked domain is connected.
    // Example: "NEXT_PUBLIC_SITE_URL": "https://www.your-domain.com"
    // Use the site origin only (no path). Until then, lib/site.ts uses the workers.dev fallback.
  },


  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
