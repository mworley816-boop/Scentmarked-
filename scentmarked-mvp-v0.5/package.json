{
  "name": "scentmarked",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build:cloudflare",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:production-env": "node scripts/check-production-env.mjs",
    "deploy:production": "npm run check:production-env && npm run check && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "wrangler": "4.147.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  }
}
